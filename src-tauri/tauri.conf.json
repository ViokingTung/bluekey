{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueKey",
  "version": "0.1.4",
  "identifier": "com.vioking.bluekey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlueKey",
        "width": 800,
        "height": 700,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "BlueKey - 蓝牙智能解锁系统",
    "longDescription": "基于蓝牙设备距离自动解锁/锁定您的电脑",
    "category": "Utility",
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
